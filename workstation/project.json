{
  "schema": 1,
  "name": "Translation",
  "kind": "video",
  "setup": [
    [
      "{bootstrap_python}",
      "-m",
      "venv",
      "{repo}/.venv"
    ],
    [
      "{python}",
      "-m",
      "pip",
      "install",
      "-e",
      "."
    ]
  ],
  "tools": [
    "git",
    "ffmpeg",
    "ffprobe"
  ],
  "credential_names": [
    "GOOGLE_CLOUD_PROJECT"
  ],
  "native_entry": "translation-video --help",
  "package_mode": "long",
  "production_execution": "explicit_native_command",
  "shared_runtime": false,
  "recommended_python": "3.12"
}
